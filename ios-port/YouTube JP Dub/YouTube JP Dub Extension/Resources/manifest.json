{
  "manifest_version": 3,
  "name": "YouTube JP Dub — 英語動画の日本語吹き替え",
  "version": "0.3.0",
  "description": "英語のYouTube動画を、YouTubeの翻訳字幕を使って日本語で音声読み上げ（吹き替え）します。",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*"
      ],
      "run_at": "document_start",
      "js": [
        "src/content/bridge-loader.js"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/watch*"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle",
      "js": [
        "src/content/ios-tts-unlock.js",
        "src/lib/storage.js",
        "src/lib/voices.js",
        "src/content/captions.js",
        "src/content/tts.js",
        "src/content/subtitle-overlay.js",
        "src/content/rate-estimator.js",
        "src/content/scheduler.js",
        "src/content/control-panel.js",
        "src/content/content.js"
      ],
      "css": [
        "styles/content.css"
      ]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "YouTube JP Dub"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/caption-bridge.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}